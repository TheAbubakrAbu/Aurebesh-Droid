# cmake/embed_fonts.cmake
#
# Writes a C++ file that holds each font as a byte array (see
# src/embedded_fonts.hpp). CMakeLists.txt runs it as a build step:
#   cmake -DFONTS=<font|font|...> -DOUTPUT=<file.cpp> -P embed_fonts.cmake
# FONTS is separated by | because ; would split the command line.

string(REPLACE "|" ";" FONTS "${FONTS}")

set(arrays "")
set(entries "")
set(index 0)
foreach(font IN LISTS FONTS)
  get_filename_component(name "${font}" NAME)
  file(READ "${font}" hex HEX)

  # Convert 32 bytes (one output line) at a time: a regex over the whole file
  # at once is very slow in CMake.
  string(LENGTH "${hex}" length)
  set(bytes "")
  set(offset 0)
  while(offset LESS length)
    string(SUBSTRING "${hex}" ${offset} 64 chunk)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," chunk "${chunk}")
    string(APPEND bytes "    ${chunk}\n")
    math(EXPR offset "${offset} + 64")
  endwhile()

  string(APPEND arrays "const unsigned char font${index}[] = {\n${bytes}};\n")
  string(APPEND entries "    {\"${name}\", font${index}, sizeof font${index}},\n")
  math(EXPR index "${index} + 1")
endforeach()

file(WRITE "${OUTPUT}" "\
// Generated by cmake/embed_fonts.cmake from src/assets/fonts. Do not edit.

#include \"embedded_fonts.hpp\"

namespace {
${arrays}
const EmbeddedFont fonts[] = {
${entries}};
}

std::span<const EmbeddedFont> embedded_fonts() {
    return fonts;
}
")
